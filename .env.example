# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase PostgreSQL connection string (use the Session pooler for serverless apps)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Mapbox Configuration
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-access-token

# AI Verification (NVIDIA NIM)
NVIDIA_NIM_API_KEY=your-nvidia-api-key
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct
# Optional override for a compatible NVIDIA NIM endpoint
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Comma-separated Supabase auth user IDs that are also manually assigned moderator profiles
MODERATOR_USER_IDS=

# Vercel Cron authorization secret
CRON_SECRET=replace-with-a-long-random-secret
