# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase PostgreSQL connection string (use the Session pooler for serverless apps)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Mapbox Configuration
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-access-token

# AI Verification (Claude API)
ANTHROPIC_API_KEY=your-anthropic-api-key
